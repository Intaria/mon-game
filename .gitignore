# ============================================================
# Unreal Engine generated directories
# ============================================================
[Bb]inaries/
[Ii]ntermediate/
[Ss]aved/
[Dd]erivedDataCache/
[Bb]uild/
[Nn]oRedist/
FileOpenOrder/
Plugins/*/Binaries/
Plugins/*/Intermediate/

# ============================================================
# IDE / editor generated files
# ============================================================
.vs/
.vscode/
.idea/
*.sln
*.xcworkspace
*.code-workspace
*.opendb
*.VC.db
*.opensdf
*.sdf
*.suo
*.user
*.userosscache
*.aps

# Project user files (regenerated by the editor)
*.uprojectuser
*.upluginuser

# ============================================================
# OS junk
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Never ignore (explicitly kept, see .gitattributes for LFS):
#   Content/   - game assets (including .uasset/.umap)
#   Config/    - engine/project ini
#   Source/    - C++ source
#   Plugins/   - plugin source
#   *.uproject, *.uplugin
#   Data/      - text-first game data (CSV/JSON), see ADR-003
# ============================================================
